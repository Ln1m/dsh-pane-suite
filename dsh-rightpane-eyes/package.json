{
    "name": "dsh-rightpane-eyes",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "lib/index.js",
    "exports": {
        ".": {
            "default": "./lib/index.js"
        },
        "./client": {
            "default": "./lib/client.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "lib",
        "cordis.patch.yml",
        "package.json"
    ],
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "inject": [
                "@deepseek-ai/dsh-client-ui-conversation"
            ],
            "platform": "web"
        }
    },
    "peerDependencies": {
        "@deepseek-ai/cordis": "*",
        "react": "^18.2.0"
    },
    "description": "拓展栏眼睛（DSH 插件）：右栏打开的本地文件在技能档那一排生成「眼睛 + 文件名」胶囊，按文件切换会话可见/隐藏；宿主用 systemPrompt.context 注入可见文件路径，内容不变时不重复注入。",
    "keywords": [
        "dsh",
        "deepseek-harness",
        "plugin",
        "sidebar-right",
        "context"
    ],
    "license": "MIT",
    "author": "Ln1m (https://github.com/Ln1m)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Ln1m/dsh-pane-suite.git",
        "directory": "dsh-rightpane-eyes"
    },
    "homepage": "https://github.com/Ln1m/dsh-pane-suite/tree/main/dsh-rightpane-eyes#readme",
    "bugs": {
        "url": "https://github.com/Ln1m/dsh-pane-suite/issues"
    }
}
