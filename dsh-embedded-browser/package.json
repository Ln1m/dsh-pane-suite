{
    "name": "dsh-embedded-browser",
    "version": "0.1.3",
    "description": "右栏内嵌浏览器：面板只报矩形，真正的画面是 DSH 桌面外壳（dsh-desktop，WinForms + WebView2）主窗体里的一块 WebView2 原生子控件，多标签共用同一浏览器进程与 9223 调试口；收藏夹由外壳单独的一块小浮层叠在画面上呈现。",
    "type": "module",
    "main": "lib/index.js",
    "scripts": {
        "check": "node --check lib/client.js && node --check lib/index.js",
        "test": "node tests/offline.mjs"
    },
    "exports": {
        ".": {
            "default": "./lib/index.js"
        },
        "./client": {
            "default": "./lib/client.js"
        },
        "./package.json": "./package.json"
    },
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "platform": "web"
        }
    },
    "peerDependencies": {
        "@deepseek-ai/cordis": "^4.0.2"
    },
    "files": [
        "lib",
        "cordis.patch.yml"
    ],
    "keywords": [
        "deepseek-harness",
        "dsh",
        "dsh-plugin",
        "webview2",
        "browser"
    ],
    "license": "MIT",
    "author": "Ln1m (https://github.com/Ln1m)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Ln1m/dsh-pane-suite.git",
        "directory": "dsh-embedded-browser"
    },
    "homepage": "https://github.com/Ln1m/dsh-pane-suite/tree/main/dsh-embedded-browser#readme",
    "bugs": {
        "url": "https://github.com/Ln1m/dsh-pane-suite/issues"
    }
}
