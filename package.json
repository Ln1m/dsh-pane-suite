{
  "name": "dsh-vk-viewer",
  "version": "0.1.0",
  "description": "3栏layout 右栏查看器：Office 文档 / 网页 / 图片 / 文本预览。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "dsh-vk-contract"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "author": "Ln1m (https://github.com/Ln1m)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ln1m/dsh-vk-viewer.git"
  },
  "homepage": "https://github.com/Ln1m/dsh-vk-viewer#readme",
  "bugs": {
    "url": "https://github.com/Ln1m/dsh-vk-viewer/issues"
  }
}
